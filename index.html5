<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Futuristic Financial Model Platform</title>
  <style>
    :root {
      --bg-dark: #0a0d14;
      --card-bg: rgba(16, 22, 36, 0.65);
      --card-border: rgba(0, 240, 255, 0.2);
      --neon-cyan: #00f0ff;
      --neon-purple: #7000ff;
      --neon-pink: #ff007f;
      --text-main: #f0f4f8;
      --text-muted: #8a99ad;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
    }

    /* Animated Canvas Background */
    #bg-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 0;
      pointer-events: none;
    }

    /* Main Interface Container */
    .app-container {
      position: relative;
      z-index: 1;
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem;
    }

    /* Glassmorphism Header */
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.25rem 2rem;
      background: var(--card-bg);
      backdrop-filter: blur(16px);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      margin-bottom: 2rem;
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
    }

    .logo {
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: 1px;
      background: linear-gradient(90deg, var(--neon-cyan), var(--neon-purple));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-transform: uppercase;
    }

    /* Futuristic Navigation Tabs */
    .tab-navigation {
      display: flex;
      gap: 0.75rem;
      background: rgba(5, 8, 15, 0.8);
      padding: 0.5rem;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .nav-tab {
      background: transparent;
      border: none;
      color: var(--text-muted);
      padding: 0.6rem 1.25rem;
      font-size: 0.875rem;
      font-weight: 600;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.3s ease;
      position: relative;
    }

    .nav-tab:hover {
      color: var(--text-main);
      background: rgba(255, 255, 255, 0.03);
    }

    .nav-tab.active {
      color: #fff;
      background: linear-gradient(135deg, rgba(0, 240, 255, 0.2), rgba(112, 0, 255, 0.2));
      border: 1px solid var(--neon-cyan);
      box-shadow: 0 0 15px rgba(0, 240, 255, 0.3);
    }

    /* Dashboard Grid Layout */
    .dashboard-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 1.5rem;
    }

    .panel {
      background: var(--card-bg);
      backdrop-filter: blur(16px);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 1.5rem;
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-bottom: 0.75rem;
    }

    .panel-title {
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--neon-cyan);
    }

    /* Metric Visual Displays */
    .metrics-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .metric-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 10px;
      padding: 1rem;
    }

    .metric-label {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-bottom: 0.25rem;
    }

    .metric-value {
      font-size: 1.25rem;
      font-weight: 700;
      color: #fff;
    }

    .metric-value.highlight {
      color: var(--neon-pink);
    }

    /* Placeholder Content Box */
    .content-placeholder {
      min-height: 250px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      border: 2px dashed rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      color: var(--text-muted);
      gap: 0.5rem;
    }

    /* Status Badge */
    .status-badge {
      font-size: 0.75rem;
      padding: 0.25rem 0.6rem;
      border-radius: 20px;
      background: rgba(0, 240, 255, 0.1);
      color: var(--neon-cyan);
      border: 1px solid var(--neon-cyan);
    }
  </style>
</head>
<body>

  <!-- Dynamic Canvas Background -->
  <canvas id="bg-canvas"></canvas>

  <div class="app-container">
    <!-- Futuristic Navigation Header -->
    <header>
      <div class="logo">FIN-MODEL // OS</div>
      <nav class="tab-navigation">
        <button class="nav-tab active" onclick="switchTab(this)">Overview</button>
        <button class="nav-tab" onclick="switchTab(this)">Valuation</button>
        <button class="nav-tab" onclick="switchTab(this)">Forecasting</button>
        <button class="nav-tab" onclick="switchTab(this)">Risk Analysis</button>
      </nav>
    </header>

    <!-- Main Workspace Grid -->
    <main class="dashboard-grid">
      <!-- Main Visual & Content Engine -->
      <section class="panel">
        <div class="panel-header">
          <h2 class="panel-title">Active Workspace</h2>
          <span class="status-badge">Engine Online</span>
        </div>

        <div class="metrics-row">
          <div class="metric-card">
            <div class="metric-label">WACC Rate</div>
            <div class="metric-value">8.42%</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">NPV Forecast</div>
            <div class="metric-value highlight">$4.2M</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">Sensitivity Variance</div>
            <div class="metric-value">±2.1%</div>
          </div>
        </div>

        <div class="content-placeholder">
          <p>Module Shell Ready</p>
          <small>(Summaries & Detailed Material To Be Loaded)</small>
        </div>
      </section>

      <!-- Sidebar / Quick Controls -->
      <aside class="panel">
        <div class="panel-header">
          <h2 class="panel-title">System Metrics</h2>
        </div>
        <div class="content-placeholder" style="min-height: 320px;">
          <p>Controls Panel</p>
        </div>
      </aside>
    </main>
  </div>

  <script>
    // Tab Switching Logic
    function switchTab(selectedBtn) {
      document.querySelectorAll('.nav-tab').forEach(btn => btn.classList.remove('active'));
      selectedBtn.classList.add('active');
    }

    // Canvas Background Animation: Animated Financial Waves & Data Nodes
    const canvas = document.getElementById('bg-canvas');
    const ctx = canvas.getContext('2d');

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    let step = 0;
    const nodes = Array.from({ length: 25 }, () => ({
      x: Math.random() * window.innerWidth,
      y: Math.random() * window.innerHeight,
      radius: Math.random() * 2 + 1,
      speedX: (Math.random() - 0.5) * 0.5,
      speedY: (Math.random() - 0.5) * 0.5
    }));

    function animate() {
      ctx.fillStyle = 'rgba(10, 13, 20, 0.2)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Draw Animated Sine Waves (Simulating Dynamic Curves/Models)
      ctx.lineWidth = 1.5;
      
      // Wave 1 - Neon Cyan
      ctx.beginPath();
      ctx.strokeStyle = 'rgba(0, 240, 255, 0.15)';
      for (let x = 0; x < canvas.width; x += 10) {
        const y = Math.sin(x * 0.003 + step) * 80 + canvas.height * 0.5;
        if (x === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();

      // Wave 2 - Neon Purple
      ctx.beginPath();
      ctx.strokeStyle = 'rgba(112, 0, 255, 0.15)';
      for (let x = 0; x < canvas.width; x += 10) {
        const y = Math.cos(x * 0.002 - step * 0.8) * 110 + canvas.height * 0.55;
        if (x === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();

      // Floating Data Nodes & Grid Connections
      nodes.forEach((node, i) => {
        node.x += node.speedX;
        node.y += node.speedY;

        if (node.x < 0 || node.x > canvas.width) node.speedX *= -1;
        if (node.y < 0 || node.y > canvas.height) node.speedY *= -1;

        ctx.fillStyle = 'rgba(0, 240, 255, 0.5)';
        ctx.beginPath();
        ctx.arc(node.x, node.y, node.radius, 0, Math.PI * 2);
        ctx.fill();

        // Connect nearby nodes
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[j].x - node.x;
          const dy = nodes[j].y - node.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < 150) {
            ctx.strokeStyle = `rgba(0, 240, 255, ${0.1 * (1 - dist / 150)})`;
            ctx.beginPath();
            ctx.moveTo(node.x, node.y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.stroke();
          }
        }
      });

      step += 0.01;
      requestAnimationFrame(animate);
    }

    animate();
  </script>
</body>
</html>
